{
  "name": "paseo-wiki-viewer",
  "version": "0.1.2",
  "description": "Paseo plugin: browse a workspace in wiki-viewer from the Explorer sidebar, and open chat file links there",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "wiki",
    "markdown",
    "viewer"
  ],
  "author": "anh-chu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anh-chu/paseo-wiki-viewer.git"
  },
  "homepage": "https://github.com/anh-chu/paseo-wiki-viewer#readme",
  "bugs": {
    "url": "https://github.com/anh-chu/paseo-wiki-viewer/issues"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "README.md",
    "LICENSE",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "!server/*.test.ts",
    "shared/",
    "assets/"
  ],
  "scripts": {
